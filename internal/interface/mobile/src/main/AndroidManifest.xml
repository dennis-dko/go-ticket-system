<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The camera reads a token's code and nothing else, asked for the first time
         somebody presses to scan one. A phone without a camera still installs the
         app and is connected by typing the address and the token. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- The reminders are shown as notifications, asked for from the Reminders
         card's own button rather than when the app opens. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A reminder falls due at a moment, and a dozing phone holds everything else
         the app could ask at it back until it wakes; an exact alarm is what is let
         through on the minute. From Android 14 on the leave is not given at
         installation, and until it is allowed under "Alarms & reminders" the
         alarm comes within the hour after instead. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Nothing of the app's is backed up or carried to another phone.
         allowBackup="false" is what says so up to Android 11, so the rules file
         lint asks for there would only repeat it; data_extraction_rule says it
         for 12 and later, where allowBackup no longer covers a transfer. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rule"
        android:icon="@mipmap/ic_launcher"
        android:label="Ticket System"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:ignore="DataExtractionRules">

        <!-- configChanges keeps the activity, and with it the web interface and
             whatever is half typed into it, through a turned screen: a WebView
             created again would load the page anew. A change between light and
             dark is left to make it anew, because the page's appearance follows
             the theme its WebView is made with; see Web.kt. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="connect" android:scheme="go-ticket-system" />
            </intent-filter>
        </activity>

        <!-- Called by the app's own alarm and by nothing else. -->
        <receiver android:name=".ReminderAlarm" android:exported="false" />
    </application>
</manifest>
